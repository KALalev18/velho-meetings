# Required: a Claude API key (sk-ant-..., https://platform.claude.com)
# or an OpenRouter key (sk-or-...). OpenRouter keys are detected automatically;
# the app then does its own web search and page reading.
ANTHROPIC_API_KEY=

# Optional
PORT=4000
# Where "Book 20 minutes" on the prospect page goes (Calendly, HubSpot meetings, mailto:...)
BOOKING_URL=
# Loaded hourly cost used for € estimates
HOURLY_COST=45
# Speed vs depth: low | medium | high | xhigh
RESEARCH_EFFORT=medium
DOSSIER_EFFORT=high
# Set to 0 to disable server-side refusal fallbacks
USE_FALLBACKS=1
